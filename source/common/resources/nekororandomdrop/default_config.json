    { "source": "block", "match": "#minecraft:deepslate_ore_replaceables", "item": "minecraft:coal", "xp": 1, "chance": 0.0082505, "min_y": -64, "max_y": -1, "min_tool": "wood", "silk_touch": "bonus" },
